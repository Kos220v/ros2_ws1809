<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gps_navigator</name>
  <version>0.2.0</version>
  <description>Навигационный слой: Nav2 + robot_localization для движения по GPS-маршруту с объездом препятствий по лидару (Raspberry Pi 5).</description>
  <maintainer email="admin@example.com">admin</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- локализация -->
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>robot_odom</exec_depend>

  <!-- Nav2 (только реально используемые серверы) -->
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>nav2_dwb_controller</exec_depend>

  <!-- миссия и железо -->
  <exec_depend>gps_mission</exec_depend>
  <exec_depend>project_start</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
