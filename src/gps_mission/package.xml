<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gps_mission</name>
  <version>0.1.0</version>
  <description>Миссия GPS-маршрута: waypoints.yaml -> Nav2 follow_gps_waypoints.</description>
  <maintainer email="admin@example.com">admin</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rclpy_action</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_waypoint_follower</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
